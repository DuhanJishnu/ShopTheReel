APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://shop:shop@postgres:5432/shopthereel
REDIS_URL=redis://redis:6379/0
# Storage: Cloudflare R2 (S3-compatible, zero egress). Create the bucket + an
# API token (Object Read & Write on that bucket) in the Cloudflare dashboard first.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=<R2_BUCKET_NAME>
S3_ACCESS_KEY=<R2_TOKEN_ACCESS_KEY>
S3_SECRET_KEY=<R2_TOKEN_SECRET_KEY>
S3_REGION=auto
JWT_SECRET=change-me
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
# Google sign-in: comma-separated OAuth client IDs accepted as ID-token audience.
# Create them in Google Cloud Console (OAuth consent + Android/Web clients).
GOOGLE_ALLOWED_CLIENT_IDS=
GEMINI_EMBED_MODEL=gemini-embedding-001
LLM_RERANK=false
MAX_VIDEO_MB=100
MAX_VIDEO_SECONDS=90
RAW_VIDEO_RETENTION_DAYS=7
SENTRY_DSN=
